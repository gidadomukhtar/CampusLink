@page "/events"

<PageTitle>CampusLink | Events</PageTitle>

<section class="cl-events-page">
    <div class="cl-events-heading">
        <p class="cl-eyebrow">CAMPUS ACTIVITIES</p>

        <h1>Discover what's happening on campus</h1>

        <p>
            Explore workshops, hackathons, conferences,
            meetups and other exciting campus activities.
            Stay up to date with the latest events and 
            make the most of your campus experience.
        </p>
    </div>

    <div class="cl-events-grid">

        <article class="cl-event-card">
            <div class="cl-event-banner">
                <span>WORKSHOP</span>
            </div>

            <div class="cl-event-details">
                <p class="cl-event-date">November 12, 2026</p>
                <h2>Introduction to Git and GitHub</h2>

                <p>
                    Learn version control, Git fundamentals,
                    and how to collaborate on software projects.
                </p>

                <p class="cl-event-location">FUDMA . Computer Lab</p>

                <a href="#event-details">View event →</a>
            </div>
        </article>

        <article class="cl-event-card">
            <div class="cl-event-banner">
                <span>HACKATHON</span>
            </div>

            <div class="cl-event-details">
                <p class="cl-event-date">November 20, 2026</p>
                <h2>Campus Innovation Challenge</h2>

                <p>
                    Work with other students to develop creative
                    solutions to real-world problems.
                </p>

                <p class="cl-event-location">Virtual (Online Event)</p>

                <a href="#event-details">View event →</a>
            </div>
        </article>

        <article class="cl-event-card">
            <div class="cl-event-banner">
                <span>MEETUP</span>
            </div>

            <div class="cl-event-details">
                <p class="cl-event-date">November 28, 2026</p>
                <h2>Developer Community Meetup</h2>

                <p>
                    Connect with fellow developers, share knowledge and ideas,
                    and explore opportunities in technology
                </p>

                <p class="cl-event-location">Dutsin-Ma Motel</p>

                <a href="#event-details">View event →</a>
            </div>
        </article>
    </div>
</section>