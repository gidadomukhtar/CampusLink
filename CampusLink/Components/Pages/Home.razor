@page "/"

<PageTitle>CampusLink | Your Campus, Connected</PageTitle>

<header class="cl-navbar">
    <a class="cl-brand" href="/">
        Campus<span>Link</span>
    </a>

    <nav class="cl-nav-links">
        <a href="#home">Home</a>
        <a href="#events">Tech & Events</a>
        <a href="#communities">Communities</a>
        <a href="#opportunities">Opportunities</a>
    </nav>

    <a class="cl-nav-cta" href="#explore">Explore Campus</a>
</header>

<main>
    <section class="cl-hero" id="home">
        <div class="cl-hero-content">
            <p class="cl-eyebrow">
                CONNECT . DISCOVER . BUILD . BELONG
            </p>

            <h1>
                Your campus.
                <span>Your community.</span>
                Your opportunities
            </h1>

            <p class="cl-hero-description">
                From tech events and hackathons to student communities,
                campus services and new opportunities, discover more of
                what university life has to offer-all in one place.
            </p>

            <div class="cl-hero-actions">
                <a class="cl-button-primary" href="#events">
                    Discover Events
                </a>

                <a class="cl-button-secondary" href="explore">
                    Explore Campus
                </a>
            </div>

            <p class="cl-hero-note">
                Built for students. Powered by community
            </p>
        </div>

        <div class="cl-hero-image">
            <img
                src="https://images.unsplash.com/photo-1523050854058-8df90110c9f1?auto=format&fit=crop&w=1200&q=85"
                alt="University students enjoying campus life"
        </div>
    </section>

    <section class="cl-next-section" id="events">
        <p class="cl-eyebrow">WHAT'S HAPPENING</p>
        <h2>Discover what's happening on campus</h2>
        <p>
            Find upcoming tech events, hackathons, workshops, student meetups and other campus activities.
        </p>
    </section>

    <section class="cl-content-section" id="events-list">
        <div class="cl-section-heading">
            <div>
                <p class="eyebrow">LEARN . CONNECT . BUILD</p>
                <h2>Upcoming Tech Events</h2>
                <p>
                    Discover workshops, developer meetups, tech talks
                    and community events happening around campus.
                </p>
            </div>

            <a class="cl-text-link" href="#all-events">Explore</a>
        </div>

        <div class="cl-card-grid">
            <article class="cl-event-card">
                <div class="cl-event-banner cl-banner-blue">
                    <span class="Cl-tag">Workshop</span>
                    <span class="Cl-event-icon">⌨</span>
                </div>

                <div class="Cl-card-body">
                    <p class="Cl-card-meta">TECH SKILLS</p>
                    <h3>Introduction to Git & GitHub</h3>
                    <p>
                        Learn version control, create your first repository,
                        and understand how developers collaborate.
                    </p>
                    <div class="cl-card-foote">
                        <span>📍 Campus tech community</span>
                        <a href="#communities">Learn more →</a>
                    </div>
                </div>
            </article>

            <article class="cl-event-card">
                <div class="cl-event-banner cl-banner-gold">
                    <span class="cl-tag">Hackathon</span>
                    <span class="cl-event-icon">⚡</span>
                </div>

                <div class="cl-card-body">
                    <p class="cl-card-meta">BUILD SOMETHING</p>
                    <h3>Campus Innovation Challenge</h3>
                    <p>
                        Team up with other students, solve a real problem,
                        and turn idea into a working prototype.
                    </p>
                    <div class="cl-card-footer">
                        <span>🤝 Teams welcome</span>
                        <a href="#projects">Explore projects →</a>
                    </div>
                </div>
            </article>

            <article class="cl-event-card">
                <div class="cl-event-banner cl-banner-green">
                    <span class="cl-tag">Community</span>
                    <span class="cl-event-icon">⌘</span>
                </div>

                <div class="cl-card-body">
                    <p class="cl-card-meta">MEET DEVELOPERS</p>
                    <h3>Developer Community Meetup</h3>
                    <p>
                        Meet fellow builders, share what you're learning,
                        and find people to work on projects with.
                    </p>
                    <div class="cl-card-footer">
                        <span>👥 All skill levels</span>
                        <a href="#communities">Find your people →</a>
                    </div>
                </div>
            </article>
        </div>
    </section>
</main>
