@page "/"

<PageTitle>CampusLink | Your Campus, Connected</PageTitle>

<header class="cl-navbar">
    <a class="cl-brand" href="/">
        Campus<span>Link</span>
    </a>

    <nav class="cl-nav-links">
        <a href="#home">Home</a>
        <a href="#events-list">Tech & Events</a>
        <a href="#communities">Communities</a>
        <a href="#opportunities">Opportunities</a>
        <a href="#campus-services">Campus Services</a>
    </nav>

    <a class="cl-nav-cta" href="#explore">Explore Campus</a>
</header>

<main>
    <section class="cl-hero" id="home">
        <div class="cl-hero-content">
            <p class="cl-eyebrow">
                CONNECT . DISCOVER . BUILD . BELONG
            </p>

            <h1>
                Your campus.
                <span>Your community.</span>
                Your opportunities
            </h1>

            <p class="cl-hero-description">
                From tech events and hackathons to student communities,
                campus services and new opportunities, discover more of
                what university life has to offer-all in one place.
            </p>

            <div class="cl-hero-actions">
                <a class="cl-button-primary" href="#events">
                    Discover Events
                </a>

                <a class="cl-button-secondary" href="explore">
                    Explore Campus
                </a>
            </div>

            <p class="cl-hero-note">
                Built for students. Powered by community
            </p>
        </div>

        <div class="cl-hero-image">
            <img
                src="https://images.unsplash.com/photo-1523050854058-8df90110c9f1?auto=format&fit=crop&w=1200&q=85"
                alt="University students enjoying campus life"
        </div>
    </section>

    <section class="cl-next-section" id="events">
        <p class="cl-eyebrow">WHAT'S HAPPENING</p>
        <h2>Discover what's happening on campus</h2>
        <p>
            Find upcoming tech events, hackathons, workshops, student meetups and other campus activities.
        </p>
    </section>

    <section class="cl-content-section" id="events-list">
        <div class="cl-section-heading">
            <div>
                <p class="eyebrow">LEARN . CONNECT . BUILD</p>
                <h2>Upcoming Tech Events</h2>
                <p>
                    Discover workshops, developer meetups, tech talks
                    and community events happening around campus.
                </p>
            </div>

            <a class="cl-text-link" href="#all-events">Explore</a>
        </div>

        <div class="cl-card-grid">
            <article class="cl-event-card">
                <div class="cl-event-banner cl-banner-blue">
                    <span class="Cl-tag">Workshop</span>
                    <span class="Cl-event-icon">⌨</span>
                </div>

                <div class="Cl-card-body">
                    <p class="Cl-card-meta">TECH SKILLS</p>
                    <h3>Introduction to Git & GitHub</h3>
                    <p>
                        Learn version control, create your first repository,
                        and understand how developers collaborate.
                    </p>
                    <div class="cl-card-foote">
                        <span>📍 Campus tech community</span>
                        <a href="#communities">Learn more →</a>
                    </div>
                </div>
            </article>

            <article class="cl-event-card">
                <div class="cl-event-banner cl-banner-gold">
                    <span class="cl-tag">Hackathon</span>
                    <span class="cl-event-icon">⚡</span>
                </div>

                <div class="cl-card-body">
                    <p class="cl-card-meta">BUILD SOMETHING</p>
                    <h3>Campus Innovation Challenge</h3>
                    <p>
                        Team up with other students, solve a real problem,
                        and turn idea into a working prototype.
                    </p>
                    <div class="cl-card-footer">
                        <span>🤝 Teams welcome</span>
                        <a href="#projects">Explore projects →</a>
                    </div>
                </div>
            </article>

            <article class="cl-event-card">
                <div class="cl-event-banner cl-banner-green">
                    <span class="cl-tag">Community</span>
                    <span class="cl-event-icon">⌘</span>
                </div>

                <div class="cl-card-body">
                    <p class="cl-card-meta">MEET DEVELOPERS</p>
                    <h3>Developer Community Meetup</h3>
                    <p>
                        Meet fellow builders, share what you're learning,
                        and find people to work on projects with.
                    </p>
                    <div class="cl-card-footer">
                        <span>👥 All skill levels</span>
                        <a href="#communities">Find your people →</a>
                    </div>
                </div>
            </article>
        </div>
    </section>

    <section class="cl-content-section" id="communities">
        <div class="cl-section-heading">
            <div>
                <p class="cl-eyebrow">FIND YOUR PEOPLE</p>
                <h2>Communities that help you grow</h2>
                <p>
                    Connect with student tech clubs, coding groups,
                    innovation communities and fellow learners.
                </p>
            </div>
        </div>

        <div class="cl-card-grid">
            <article class="cl-event-card cl-simple-card">
                <h3>Developer Communities</h3>
                <p>
                    Find groups where students share knowledge,
                    organize meetups and learn together.
                </p>
                <a class="cl-text-link" href="#opportunities">
                    Discover communities →
                </a>
            </article>

            <article class="cl-event-card cl-simple-card">
                <h3>Open-Source Collaboration</h3>
                <p>
                    Discover projects, contribute code, report issues,
                    and learn how collaborative software is built.
                </p>
                <a class="cl-text-link" href="#projects">
                    Explore projects →
                </a>
            </article>

            <article class="cl-event-card cl-simple-card">
                <h3>Find Teammates</h3>
                <p>
                    Meet students with complementary skills and
                    start building something useful together.
                </p>
                <a class="cl-text-link" href="#projects">
                    Start collaborating →
                </a>
            </article>
        </div>
    </section>

    <section class="cl-content-section cl-project-section" id="projects">
        <div class="cl-section-heading">
            <div>
                <p class="cl-eyebrow">IDEAS INTO REALITY</p>
                <h2>What are students building?</h2>
                <p>
                    A home for student projects, hackathon submissions, 
                    and open-source contributions. Find inspiration, 
                    learn from others, and get involved.
                </p>
            </div>
        </div>

        <div class="cl-project-panel">
            <h3>Your next project could start here.</h3>
            <p>
                Showcase what you've built, find contributions,
                or join a team working on something exciting. 
                Whether it's a hackathon project, a student 
                club initiative, or an open-source contribution,
                you'll find a place to share your work and 
                connect with like-minded individuals.
            </p>
            <a class="cl-button-primary" href="#opportunities">
                Explore opportunities
            </a>
        </div>
    </section>

    <section class="cl-content-section" id="opportunities">
        <div class="cl-section-heading">
            <div>
                <p class="cl-eyebrow">TAKE YOUR NEXT STEP</p>
                <h2>Opportunities beyond the classroom</h2>
                <p>
                    Make space for internships, scholarships,
                    competitions, volunteering and student leadership.
                </p>
            </div>
        </div>

        <div class="cl-opportunity-strip">
            <div>
                <h3>Learn something new</h3>
                <p>Find workshops, learning resources and skill-building activities.</p>
            </div>
            <div>
                <h3>Show what you can do</h3>
                <p>Discover competitons, project showcases and hackathons.</p>
            </div>
            <div>
                <h3>Grow your experience</h3>
                <p>Explore internships, scholarships, leadership opportunities and more.</p>
            </div>
        </div>    
    </section>

    <section class="cl-content-section" id="campus-services">
        <div class="cl-section-heading">
            <div>
                <p class="cl-eyebrow">MORE THAN JUST A CAMPUS</p>
                
                <h2>Everything you need, in one campus space.</h2>

                <p>Access useful services, connect with fellow students,
                    and stay informed about what's happening around you.
                    From campus resources and student support to tech 
                    clubs and community events, CampusLink is your go-to 
                    platform for all things campus life.
                </p>
            </div>
        </div>

        <div class="cl-service-grid">
            <article class="cl-service-card">
                <h3>Student Directory</h3>
                <p>Find and connect with fellow students.</p>
                <a class="cl-text-link" href="#student-directory">
                    Explore directory →
                </a>
            </article>

            <article class="cl-service-card">
                <h3>Lost and Found</h3>
                <p>Report lost belongings and help people reunite with their items.</p>
                <a class="cl-text-link" href="#lost-found">
                    Report found →
                </a>
            </article>

            <article class="cl-service-card">
                <h3>Venue Management</h3>
                <p>Find and coordinate available spaces for lectures, meetings, and events.</p>
                <a class="cl-text-link" href="#venue-management">Find available venues→</a>
            </article>

            <article class="cl-service-card">
                <h3>Campus Announcements</h3>
                <p>Stay updated on important news, updates, and announcements from the campus.</p>
                <a class="cl-text-link" href="#events-list">Discover events →</a>
            </article>
        </div>
    </section>
</main>

<footer class="cl-footer">
    <div class="cl-footer-content">

        <div class="cl-footer-brand">
            Campus<span>Link</span>
        </div>

        <p>
            Connecting students, communities, opportunities,
            and campus experiences in one place.
        </p>
    </div>

    <div class="cl-footer-links">
        <h3>Explore</h3>
        <a href="#home">Home</a>
        <a href="#events">Events</a>
        <a href="#communities">Communities</a>
        <a href="#opportunities">Opportunities</a>
    </div>

    <div class="cl=footer-links">
        <h3>Campus Services</h3>
        <a href="#campus-services">Student Direction</a>
        <a href="campus-services">Lost and Found</a>
        <a href="#campus-services">Venue Management</a>
        <a href="#campus-services">Announcements</a>
    </div>

    <div class="cl-footer-links">
        <h3>Get Involved</h3>
        <a href="#communities">Join a cammunity</a>
        <a href="events">Attend an Event</a>
        <a href="#opportunities">Find Opportunities</a>
    </div>

    <div class="cl-footer-bottom">
        <p>&copy 2026 CampusLink. Built for campus communities.</p>
        <p>Connect. Discover. Build. Belong</p>
    </div>
</footer>
