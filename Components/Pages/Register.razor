@page "/register"
@using CampusLink.Models


<PageTitle>Create Account | CampusLink</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md 7 col-lg-6">

            <div class="text-center mb-4">
                <h1>Create your CampusLink account</h1>
                <p class="text-muted">
                    Connect with your campus community.
                </p>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    @if (Error == "invalid")
                    {
                        <div class="alert alert-warning">
                            Please check your registration details.
                        </div>
                    }
                    else if (Error == "account")
                    {
                        <div class="alert alert-danger">
                            We couldn't create your account. Your email may already be registered.
                        </div>
                    }
                    else if (Error == "role")
                    {
                        <div class="alert alert-danger">
                            We couldn't complete your registration. Please try again.
                        </div>
                    }

                    <form method="post" action="/account/register">
                    
                        <AntiforgeryToken />

                        <div class="mb-3">
                            <label class="form-label">Full Name</label>
                            <input name="FullName" class="form-control"
                                   placeholder="Enter your full name" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email Address</label>
                            <input name="Email" type="email" class="form-control"
                                   placeholder="you@example.com" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input name="Password" type="password" class="form-control"
                                   minlength="8" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Confirm Password</label>
                            <input name="ConfirmPassword" type="password"
                                   class="form-control" minlength="8" required />
                        </div>

                        <hr />

                        <h5 class="mb-3">Your Campus Information</h5>

                        <div class="mb-3">
                            <label class="form-label">University</label>
                            <input name="University" class="form-control"
                                   placeholder="Your university" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Faculty</label>
                            <input name="Faculty" class="form-control"
                                   placeholder="Your faculty" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Department</label>
                            <input name="Department" class="form-control"
                                   placeholder="Your department" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Level</label>
                            <select name="Level" class="form-select" required>
                                <option value="">Select your level</option>
                                <option value="100 Level">100 Level</option>
                                <option value="200 Level">200 Level</option>
                                <option value="300 Level">300 Level</option>
                                <option value="400 Level">400 Level</option>
                                <option value="500 Level">500 Level</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Create Account
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <span>Already have an account?</span>
                        <a href="/login">Log in</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
   [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}