@page "/login"
@using CampusLink.Models

<PageTitle>Log in | CampusLink</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="text-center mb-4">
                <h1>Welcome back</h1>
                <p class="text-muted">
                    Log in to your CampusLink account.
                </p>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    @if (Error == "invalid")
                    {
                        <div class="alert alert-danger">
                            Invalid email or password. Please try again.
                        </div>
                    }

                    <form method="post" action="/account/login">
                        <AntiforgeryToken />

                        <div class="mb-3">
                            <label class="form-label">Email Address</label>
                            <input name="Email" type="email" class="form-control" placeholder="you@example.com" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Password</label>
                            <input name="password" type="password" class="form-control" placeholder="Enter your passqord" required />
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Log in
                        </button>
                    
                    </form>

                    <div class="text-center mt-4">
                        <span>Don't have an account?</span>
                        <a href="/register">Create one</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}