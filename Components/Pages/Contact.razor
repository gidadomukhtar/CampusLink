@page "/contact"

<PageTitle>Contact Us | CampusLink</PageTitle>

<main class="cl-contact-page">

    <section class="cl-contact-heading">
        <p class="cl-eyebrow">WE"D LOVE TO HEAR FROM YOU</p>

        <h1>Let's Start a Conversation</h1>

        <p>
            Have a question, suggestion, feedback, or an idea
            for CampusLink? Send us a message and we're listening.
            We value your input and look forward to connecting
             with you.
        </p>
    </section>

    <section class="cl-contact-container">

        <div class="cl-contact-info">
            <h2>Get in Touch</h2>

            <p>
                whether you're a student, lecturer, community
                organizer, or potential partner, we'd be glad
                to hear from you and explore how we can 
                collaborate to make a positive impact.
            </p>

            <div class="cl-contact-info-item">
                <h3>Generaal enquiries</h3>
                <p>Questions about CampusLink and its features.</p>
            </div>

            <div class="cl-contact-info-item">
                <h3>Feedback and suggestions</h3>
                <p>Share ideas that could make campus life better.</p>
            </div>

            <div class="cl-contact-info-item">
                <h3>Partnerships and collaborations</h3>
                <p>Interested in collaborating with CampusLink?</p>
            </div>
        </div>

        <form class="cl-contact-form"
            action="https://formspree.io/f/xaeyvodj"
            method="POST">

           <h2>Send us a message</h2>
           
           <label for="name">Full Name</label>
           <input id="contact-name" type="text" name="name" placeholder="Enter your full name" required />

           <label for="contact-email">Email Address</label>
           <input id="contact-email" type="email" name="email" placeholder="adam@example.com" required />

           <label for="contact-subject">Subject</label>
           <input id="contact-subject" type="text" name="_subject" placeholder="Enter the subject of your message" required />

           <label for="contact-message">Your Message</label>
           <textarea id="contact-message" name="message" rows="6" placeholder="Write your message here..." required></textarea>

           <button type="submit" class="cl-button-primary"> Send Message</button>">


            </form>
    </section>
</main>